{
  "name": "lamp-control-panel",
  "version": "1.0.0",
  "description": "Advanced LAMP and PHP control dashboard with Electron frontend",
  "homepage": "https://github.com/Abdelilah/lamp-control-panel",
  "author": "Abdelilah <albaroudiabdelilah92@gmail.com>",
  "main": "main.js",
  "license": "MIT",
  "desktopName": "lamp-control-panel.desktop",
  "scripts": {
    "start": "electron . --no-sandbox",
    "dev": "electron . --disable-gpu --no-sandbox",
    "check-deps": "node scripts/check-deps.js",
    "install-deps": "node scripts/check-deps.js --install",
    "build": "electron-builder --linux AppImage deb --win nsis",
    "build-fedora": "electron-builder --linux AppImage",
    "build-linux": "electron-builder --linux AppImage rpm",
    "build-win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.abdelilah.lampcontrolpanel",
    "productName": "LAMP Control Panel",
    "icon": "build/icon.png",
    "files": [
      "package.json",
      "main.js",
      "preload.js",
      "renderer/**/*",
      "src/**/*",
      "scripts/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "linux": {
      "maintainer": "Abdelilah <albaroudiabdelilah92@gmail.com>",
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "rpm"
      ],
      "category": "Development",
      "executableArgs": [
        "--no-sandbox"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-setup.${ext}"
    }
  }
}
